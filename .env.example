# ---------------------------------------------------------------
# Variables de entorno (se configuran en Vercel > Settings > Environment Variables)
# Todas son opcionales. Sin ninguna, la calculadora funciona con acceso libre.
# ---------------------------------------------------------------

# Links personalizados por media owner. Formato: codigo:Nombre,codigo2:Nombre 2
# Si se define, solo se puede entrar con un link tipo https://tu-dominio.vercel.app/?k=codigo
# Si se deja vacío, el acceso es libre.
ACCESS_CODES=

# URL a la que se envía cada consulta (contacto + datos + resultado).
# Ej: la URL de un Google Apps Script que escribe en una Google Sheet (ver README).
LEADS_WEBHOOK_URL=

# Pedir nombre, empresa y email antes de mostrar el resultado (true / false). Por defecto: true
REQUIRE_LEAD=true
